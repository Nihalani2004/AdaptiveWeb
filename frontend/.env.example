MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/adaptiveweb

# Optional direct-host fallback for networks where MongoDB SRV DNS lookups fail.
MONGODB_SEED_HOSTS=host-1.example.mongodb.net:27017,host-2.example.mongodb.net:27017,host-3.example.mongodb.net:27017
MONGODB_REPLICA_SET=atlas-example-shard-0
MONGODB_AUTH_SOURCE=admin
